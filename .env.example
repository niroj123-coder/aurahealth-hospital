# =============================================================================
# Darwin City Hospital — Environment Configuration Template (.env.example)
# Fictional Australian Healthcare Platform & Level-1 Trauma Centre
# =============================================================================

# Server Port
PORT=3000

# -----------------------------------------------------------------------------
# Gmail SMTP Configuration via Nodemailer
# -----------------------------------------------------------------------------
# Instructions:
# 1. Log into your Google Account at https://myaccount.google.com/
# 2. Go to "Security" -> Enable "2-Step Verification"
# 3. Search for "App Passwords" (or visit https://myaccount.google.com/apppasswords)
# 4. Create an App Password with the name: "Darwin City Hospital"
# 5. Copy the 16-character code (e.g. abcd efgh ijkl mnop)
# 6. Paste it into SMTP_PASS below
# 7. Do NOT use your standard Gmail account password!
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
ADMIN_EMAIL=your-admin-email@gmail.com
